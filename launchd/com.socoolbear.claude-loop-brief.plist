<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.socoolbear.claude-loop-brief</string>

  <!-- dotfiles 위치에 의존하지 않도록 ~/.local/bin 심링크를 경유해 실행 -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec "$HOME/.local/bin/claude-loop" brief</string>
  </array>

  <!-- 예약 시각: 매일 08:30 — 밤사이 결과를 요약하고 야간 모드를 끝낸다 (실행 허용 구간 07~11시 안) -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <!-- 예약 시각에만 실행. 로그인/로드 직후 실행은 금지 -->
  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
